#!/bin/bash
# Hook de Omarchy para omarchy-hwcheck. El mismo archivo va en dos carpetas y sabe en cuál está:
#
# - post-update.d: corre dentro de `omarchy update`, después de los paquetes y ANTES de ofrecer el
#   reinicio. Muestra el informe en la terminal de la actualización y avisa si hay un fallo (por ejemplo,
#   NVIDIA sin compilar para el kernel nuevo: reiniciar así daría pantalla negra).
# - post-boot.d: corre al arrancar el escritorio. Compara con la línea base (el último arranque sano),
#   avisa solo si hay fallos o regresiones y, si todo está igual o mejor, la renueva.
#
# Informes: ~/.local/state/omarchy-hwcheck/last-<evento>.txt. Nunca hace fallar al evento que lo llama.

bin=$HOME/.local/bin/omarchy-hwcheck
[[ -x $bin ]] || exit 0

event=$(basename "$(dirname "$0")" .d) # se instala como copia en cada carpeta, no como enlace
dir=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-hwcheck
report=$dir/last-$event.txt
mkdir -p "$dir"

notify() {
  local urgency=$1 title=$2 body=$3
  if command -v omarchy-notification-send > /dev/null; then
    omarchy-notification-send -u "$urgency" -g 󰾲 "$title" "$body" --exec xdg-terminal-exec less -R "$report" || true
  else
    notify-send -u "$urgency" "$title" "$body" || true
  fi
}

case $event in
  post-update)
    echo -e "\e[32m\nValidate drivers (omarchy-hwcheck)\e[0m"
    "$bin" scan | tee "$report"
    scan_rc=${PIPESTATUS[0]}
    "$bin" diff | tee -a "$report"
    diff_rc=${PIPESTATUS[0]}
    if ((scan_rc == 2 || diff_rc == 2)); then
      echo -e "\e[31momarchy-hwcheck encontró fallos: resuélvelos ANTES de reiniciar ($report)\e[0m"
      notify critical "Drivers: revisa antes de reiniciar" "omarchy-hwcheck encontró fallos tras la actualización."
    elif ((scan_rc == 1)); then
      notify normal "Drivers: avisos tras la actualización" "omarchy-hwcheck dejó avisos; clic para verlos."
    fi
    ;;
  post-boot)
    # Se separa del arranque (no retrasa los demás hooks) y espera a que los dispositivos se asienten:
    # bt-guardian puede tardar hasta ~2 min en recuperar el Bluetooth, y compararlo antes daría una falsa regresión.
    if [[ -z ${HWCHECK_DETACHED:-} ]]; then
      HWCHECK_DETACHED=1 setsid -f bash "$0" > /dev/null 2>&1
      exit 0
    fi
    sleep "${HWCHECK_SETTLE:-30}"
    baseline=$dir/baseline.json
    want_bt=$(python3 -c 'import json,sys; print(len(json.load(open(sys.argv[1])).get("bluetooth", [])))' \
      "$baseline" 2> /dev/null || echo 0)
    for ((i = 0; i < ${HWCHECK_BT_WAIT:-150} && want_bt > 0; i += 5)); do
      compgen -G '/sys/class/bluetooth/hci*' > /dev/null && break
      sleep 5
    done
    {
      "$bin" scan
      echo "scan=$?"
      "$bin" diff
      echo "diff=$?"
    } > "$report" 2>&1
    scan_rc=$(sed -n 's/^scan=\([0-9]*\)$/\1/p' "$report")
    diff_rc=$(sed -n 's/^diff=\([0-9]*\)$/\1/p' "$report")
    if [[ $scan_rc == 2 || $diff_rc == 2 ]]; then
      notify critical "Drivers: algo falla en este arranque" "omarchy-hwcheck encontró fallos o regresiones."
    elif [[ $diff_rc == 1 ]]; then
      notify normal "Drivers: cambió un driver" \
        "Si es esperado: omarchy-hwcheck baseline --force. Clic para ver el informe."
    fi
    if [[ $diff_rc == 3 ]]; then
      "$bin" baseline >> "$report" 2>&1 # primera vez: no había línea base
    elif [[ $diff_rc == 0 && $scan_rc != 2 ]]; then
      "$bin" baseline --force > /dev/null 2>&1 # mismo hardware o mejor: este arranque es la nueva referencia
    fi
    ;;
esac
exit 0

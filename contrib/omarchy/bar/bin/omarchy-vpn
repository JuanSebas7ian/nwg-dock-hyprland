#!/usr/bin/python3 -B
"""omarchy-vpn: Surfshark and Proton VPN (Free) through NetworkManager, for the VPN bar widget.

Surfshark: one WireGuard key pair for the whole account. Import any .conf generated at
my.surfshark.com → VPN → Manual setup → WireGuard once; its private key is kept and the widget
connects to any of Surfshark's locations (public list at api.surfshark.com: country, city, region,
load and each server's public key) by writing the profile for that location.
Proton VPN Free: each .conf from account.protonvpn.com → Downloads → WireGuard is one free server.

Activating a profile needs no root (polkit grants network-control to the active session). The
official apps (surfshark, protonvpn-app) keep working alongside; `status` also reports their
connections.

  omarchy-vpn status [--refresh]       JSON: connection, location, traffic, public IP, setup
  omarchy-vpn locations [--refresh]    JSON: Surfshark locations + Proton servers, recent ones
  omarchy-vpn connect <provider> <id>  surfshark <host, e.g. co-bog.prod.surfshark.com> | proton <uuid>
  omarchy-vpn down                     disconnect every VPN
  omarchy-vpn toggle                   down if connected, else the last location used
  omarchy-vpn import [file.conf ...]   none = the WireGuard .conf files in ~/Downloads
  omarchy-vpn delete <uuid>            remove an imported Proton server
  omarchy-vpn forget-surfshark         remove the stored Surfshark key and profile
  omarchy-vpn surfshark-keygen [--force]  make the key pair HERE (private key never leaves the PC);
                                       prints the public key and copies it: paste it at my.surfshark.com →
                                       VPN → Manual setup → Desktop or mobile → WireGuard → I have a key pair
  omarchy-vpn leaktest                 IP + DNS leak test (bash.ws): which resolvers answer your queries

Connecting checks that the server answers (WireGuard handshake = bytes received through the
tunnel); if it does not within 8 s, the tunnel is taken down again so the PC is never left offline.

Profiles get no autoconnect, DNS exclusive to the tunnel (dns-priority -50, no DNS leaks) and,
when the provider gives no IPv6 (Surfshark), an IPv6 blackhole through the tunnel so IPv6 cannot
leak around it. Imported .conf files (they hold the private key) move to
~/.config/omarchy-vpn/configs/ with mode 0600.
"""
import json
import os
import random
import socket
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request
from concurrent.futures import ThreadPoolExecutor, wait
from pathlib import Path

HOME = Path.home()
CONF_DIR = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "omarchy-vpn"
CONFIGS = CONF_DIR / "configs"
SS_KEY = CONF_DIR / "surfshark.json"
STATE = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "omarchy-vpn"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "omarchy-vpn"
IP_CACHE = STATE / "ip.json"
LAST = STATE / "last.json"
RECENT = STATE / "recent.json"
SESSION = STATE / "session.json"
HOME_NET = STATE / "home.json"     # the ISP as seen without VPN, for the leak test
CLUSTERS = CACHE / "surfshark-clusters.json"
DOWNLOADS = HOME / "Downloads"

SS_API = "https://api.surfshark.com/v3/server/clusters/generic"
SS_PROFILE = "Surfshark"
SS_IFACE = "ss-wg"
# Every Surfshark manual WireGuard setup uses this tunnel address and these resolvers.
SS_ADDRESS = "10.14.0.2/16"
SS_DNS = "162.252.172.57, 149.154.159.92"
PROVIDERS = {
    "surfshark": {"label": "Surfshark", "app": "surfshark", "web": "https://my.surfshark.com/vpn/manual-setup/main/wireguard"},
    "proton": {"label": "Proton", "app": "protonvpn-app", "web": "https://account.protonvpn.com/downloads"},
}
VPN_TYPES = {"wireguard", "vpn", "tun"}
# ULA used only to route IPv6 into a tunnel that has none: the provider drops it, apps fall back to IPv4.
V6_BLACKHOLE = "fd00:5f5f:5f5f::2/128"
IP_TTL = 300
CLUSTERS_TTL = 6 * 3600
REGION_ORDER = ["The Americas", "Europe", "Asia Pacific", "Middle East and Africa"]
# Countries Proton's free plan uses, for when the Surfshark list is not cached yet.
FALLBACK_COUNTRIES = {
    "NL": ("Netherlands", "Europe"), "JP": ("Japan", "Asia Pacific"), "US": ("United States", "The Americas"),
    "RO": ("Romania", "Europe"), "PL": ("Poland", "Europe"), "CA": ("Canada", "The Americas"),
    "NO": ("Norway", "Europe"), "SG": ("Singapore", "Asia Pacific"), "CH": ("Switzerland", "Europe"),
    "MX": ("Mexico", "The Americas"), "CO": ("Colombia", "The Americas"),
}


def nmcli(*args, check=True):
    r = subprocess.run(["nmcli", *args], capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"})
    if check and r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip() or f"nmcli {args[0]} failed")
    return r.stdout


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def write_json(path, data, mode=0o644):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    tmp.chmod(mode)
    tmp.replace(path)


def split_terse(line):
    # nmcli -t escapes ':' as '\:'
    return [p.replace("\\:", ":") for p in re.split(r"(?<!\\):", line)]


def provider_of(name):
    n = name.lower()
    if "surfshark" in n:
        return "surfshark"
    if "proton" in n or n.startswith("pvpn"):
        return "proton"
    return "other"


def connections():
    out = []
    for line in nmcli("-t", "-f", "NAME,UUID,TYPE,DEVICE,ACTIVE,TIMESTAMP", "connection", "show").splitlines():
        name, uuid, ctype, dev, active, ts = (split_terse(line) + [""] * 6)[:6]
        if ctype not in VPN_TYPES:
            continue
        out.append({
            "name": name, "uuid": uuid, "type": ctype, "device": dev,
            "active": active == "yes", "lastUsed": int(ts or 0),
            "provider": provider_of(name), "imported": name == SS_PROFILE or name.startswith("Proton "),
        })
    out.sort(key=lambda c: c["name"].lower())
    return out


# --------------------------------------------------------------------------- locations

def clusters(refresh=False):
    """Surfshark's public location list, cached 6 h; a stale copy beats none when offline."""
    cached = read_json(CLUSTERS)
    if cached and not refresh and time.time() - cached.get("ts", 0) < CLUSTERS_TTL:
        return cached["items"]
    try:
        req = urllib.request.Request(SS_API, headers={"User-Agent": "omarchy-vpn"})
        with urllib.request.urlopen(req, timeout=8) as r:
            raw = json.loads(r.read().decode())
        items = [{
            "id": c["connectionName"], "cc": c.get("countryCode", ""), "country": c.get("country", ""),
            "city": c.get("location", ""), "region": c.get("region", ""), "load": c.get("load"),
            "pubKey": c.get("pubKey", ""), "virtual": "virtual" in (c.get("tags") or []),
        } for c in raw if c.get("connectionName") and c.get("pubKey")]
        items.sort(key=lambda c: (c["country"], c["city"]))
        write_json(CLUSTERS, {"ts": int(time.time()), "items": items})
        return items
    except Exception:  # noqa: BLE001 - offline: keep what we had
        return cached["items"] if cached else []


def countries(items):
    m = {c["cc"]: (c["country"], c["region"]) for c in items}
    for cc, v in FALLBACK_COUNTRIES.items():
        m.setdefault(cc, v)
    return m


def proton_location(conn, names):
    """'Proton NL-FREE-7' → Netherlands, Free #7."""
    tail = conn["name"].split(" ", 1)[1] if " " in conn["name"] else conn["name"]
    m = re.match(r"([A-Z]{2})(?:-([A-Z]+))?(?:[-#]?(\d+))?", tail.upper())
    cc = m.group(1) if m else ""
    country, region = names.get(cc, (tail, ""))
    city = (m.group(2).title() + " #" + m.group(3)) if m and m.group(2) and m.group(3) else tail
    return {"id": conn["uuid"], "cc": cc, "country": country, "city": city, "region": region,
            "load": None, "provider": "proton", "name": conn["name"]}


def locations(refresh=False):
    items = clusters(refresh)
    names = countries(items)
    proton = [proton_location(c, names) for c in connections() if c["provider"] == "proton" and c["imported"]]
    ss = [dict(c, provider="surfshark") for c in items]
    for c in ss:
        c.pop("pubKey", None)
    return {"surfshark": ss, "proton": proton, "regions": REGION_ORDER,
            "recent": read_json(RECENT, []), "surfsharkReady": SS_KEY.exists()}


# --------------------------------------------------------------------------- status

def traffic(dev):
    base = Path("/sys/class/net") / dev / "statistics"
    try:
        return int((base / "rx_bytes").read_text()), int((base / "tx_bytes").read_text())
    except (OSError, ValueError):
        return None, None


def details(c):
    d = {}
    for line in nmcli("-t", "-f", "IP4.ADDRESS,IP4.DNS,IP6.ADDRESS", "connection", "show", c["uuid"], check=False).splitlines():
        k, _, v = line.partition(":")
        k = k.split("[")[0]
        if v:
            d.setdefault(k.lower().replace("ip4.", "ipv4_").replace("ip6.", "ipv6_"), []).append(v)
    if c["type"] == "wireguard":
        ep = nmcli("-t", "-f", "wireguard.peers", "connection", "show", c["uuid"], check=False)
        m = re.search(r"endpoint=([^,\s]+)", ep)
        if m:
            d["endpoint"] = m.group(1)
    if c["device"]:
        d["rx"], d["tx"] = traffic(c["device"])
    return d


def apps():
    res = {}
    for pid, p in PROVIDERS.items():
        res[pid] = {"installed": shutil.which(p["app"]) is not None, "running": False}
    for pid, pat in (("surfshark", "/opt/Surfshark/surfshark"), ("proton", "protonvpn-app")):
        r = subprocess.run(["pgrep", "-f", "-u", str(os.getuid()), pat], capture_output=True)
        res[pid]["running"] = r.returncode == 0
    return res


def fetch_json(url, timeout=4):
    req = urllib.request.Request(url, headers={"User-Agent": "omarchy-vpn"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def public_ip(refresh=False, key=""):
    """Public address via am.i.mullvad.net (no account, no key). Cached per VPN state (`key`)."""
    cached = read_json(IP_CACHE, {})
    if not refresh and cached.get("key") == key and time.time() - cached.get("ts", 0) < IP_TTL:
        return cached
    res = {"key": key, "ts": int(time.time())}
    try:
        j = fetch_json("https://ipv4.am.i.mullvad.net/json")
        res["ipv4"] = {k: j.get(k) for k in ("ip", "country", "city", "organization")}
    except Exception as e:  # noqa: BLE001 - offline, DNS, timeout: report, do not fail
        res["ipv4Error"] = str(e)[:120]
    try:
        j = fetch_json("https://ipv6.am.i.mullvad.net/json", timeout=3)
        res["ipv6"] = {k: j.get(k) for k in ("ip", "country", "organization")}
    except Exception:  # noqa: BLE001 - no IPv6 route = nothing can leak over IPv6
        res["ipv6"] = None
    write_json(IP_CACHE, res)
    if key == "" and res.get("ipv4"):
        write_json(HOME_NET, {"ipv4": res["ipv4"], "ipv6": res.get("ipv6"), "ts": res["ts"]})
    return res


def location_for(conn, items=None):
    """Where an active connection goes: the Surfshark location we wrote, a Proton server, or unknown."""
    if conn["provider"] == "surfshark" and conn["name"] == SS_PROFILE:
        sess = read_json(SESSION, {})
        host = sess.get("id")
        for c in items if items is not None else clusters():
            if c["id"] == host:
                return {k: c[k] for k in ("id", "cc", "country", "city", "region", "load")} | {"provider": "surfshark"}
        return {"id": host, "cc": "", "country": host or "Surfshark", "city": "", "region": "", "load": None, "provider": "surfshark"}
    if conn["provider"] == "proton" and conn["imported"]:
        return proton_location(conn, countries(items if items is not None else clusters()))
    return {"id": conn["uuid"], "cc": "", "country": conn["name"], "city": "", "region": "", "load": None, "provider": conn["provider"]}


def status(refresh_ip=False):
    conns = connections()
    active = [c for c in conns if c["active"]]
    items = clusters()
    cur = None
    if active:
        cur = dict(active[0])
        cur.update(details(cur))
        cur["location"] = location_for(cur, items)
        sess = read_json(SESSION, {})
        cur["since"] = sess.get("since") if sess.get("uuid") == cur["uuid"] else None
    ip = public_ip(refresh_ip, ",".join(c["uuid"] for c in active))
    v6, v4 = ip.get("ipv6") or {}, ip.get("ipv4") or {}
    # IPv6 leak: a tunnel is up but IPv6 still reaches the internet through another network.
    leak = bool(active and v6.get("ip") and v4.get("organization") and v6.get("organization") != v4.get("organization"))
    last = read_json(LAST, {})
    if last.get("provider") == "surfshark":
        last["location"] = next(({k: v for k, v in c.items() if k != "pubKey"} | {"provider": "surfshark"}
                                 for c in items if c["id"] == last.get("id")), None)
    elif last.get("provider") == "proton":
        last["location"] = next((proton_location(c, countries(items)) for c in conns if c["uuid"] == last.get("id")), None)
    return {
        "connected": bool(active), "current": cur, "ip": ip, "ipv6Leak": leak, "last": last,
        "setup": {
            "surfshark": SS_KEY.exists(), "surfsharkLocations": len(items), "surfsharkKey": key_info(),
            "proton": [proton_location(c, countries(items)) for c in conns if c["provider"] == "proton" and c["imported"]],
        },
        "other": [c for c in conns if c["provider"] == "other" or not c["imported"]],
        "apps": apps(), "inbox": [str(p) for p in downloads_candidates()],
        "web": {p: v["web"] for p, v in PROVIDERS.items()},
    }


# --------------------------------------------------------------------------- connect

def down():
    for c in connections():
        if c["active"]:
            nmcli("connection", "down", "uuid", c["uuid"], check=False)


def remember(provider, loc_id, uuid, label):
    entry = {"provider": provider, "id": loc_id}
    write_json(LAST, entry)
    write_json(SESSION, {"uuid": uuid, "id": loc_id, "provider": provider, "since": int(time.time())})
    recent = [r for r in read_json(RECENT, []) if (r.get("provider"), r.get("id")) != (provider, loc_id)]
    write_json(RECENT, ([dict(entry, label=label)] + recent)[:5])


def dns_probe(server):
    """One tiny DNS query (A surfshark.com) to make WireGuard handshake and get a reply back."""
    q = random.randbytes(2) + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00\x09surfshark\x03com\x00\x00\x01\x00\x01"
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as so:
            so.settimeout(1)
            so.sendto(q, (server, 53))
            so.recv(512)
            return True
    except OSError:
        return False


def verify_tunnel(uuid, dns_server, timeout=8):
    """True once the server answered through the tunnel (bytes received). WireGuard 'connects'
    locally even with a key the server does not know; only a reply proves the handshake."""
    dev = next((c["device"] for c in connections() if c["uuid"] == uuid), "")
    end = time.time() + timeout
    while time.time() < end:
        dns_probe(dns_server)
        rx, _ = traffic(dev) if dev else (None, None)
        if rx:
            return True
        time.sleep(0.5)
    return False


def first_dns(uuid, default):
    out = nmcli("-g", "ipv4.dns", "connection", "show", uuid, check=False).strip()
    return out.split(",")[0].strip() if out else default


def bring_up(uuid, dns_server, fail_msg):
    nmcli("--wait", "20", "connection", "up", "uuid", uuid)
    if not verify_tunnel(uuid, dns_server):
        nmcli("connection", "down", "uuid", uuid, check=False)
        raise RuntimeError(fail_msg)


def surfshark_conf(loc, key):
    return (f"[Interface]\nPrivateKey = {key['privateKey']}\nAddress = {key['address']}\nDNS = {key['dns']}\n\n"
            f"[Peer]\nPublicKey = {loc['pubKey']}\nAllowedIPs = 0.0.0.0/0\nEndpoint = {loc['id']}:51820\n")


def connect_surfshark(host):
    key = read_json(SS_KEY)
    if not key:
        raise RuntimeError("Surfshark is not set up: create the key in Accounts & servers first")
    loc = next((c for c in clusters() if c["id"] == host), None) or next((c for c in clusters(refresh=True) if c["id"] == host), None)
    if not loc:
        raise RuntimeError(f"unknown Surfshark location {host}")
    down()
    for c in connections():
        if c["name"] == SS_PROFILE:
            nmcli("connection", "delete", "uuid", c["uuid"])
    uuid = nm_import(surfshark_conf(loc, key), SS_IFACE, SS_PROFILE)
    bring_up(uuid, key["dns"].split(",")[0].strip(),
             "Surfshark did not answer: the key is not registered yet. Paste the public key at my.surfshark.com → "
             "VPN → Manual setup → WireGuard → I have a key pair, Save, and connect again."
             if not key.get("verified") else f"{loc['city']} did not answer in 8 s; try another location.")
    if not key.get("verified"):
        write_json(SS_KEY, dict(key, verified=True), mode=0o600)
    remember("surfshark", host, uuid, f"{loc['city']}, {loc['country']}")
    return {"ok": True, "name": f"{loc['city']}, {loc['country']}"}


def connect_proton(uuid):
    c = next((c for c in connections() if c["uuid"] == uuid), None)
    if not c:
        raise RuntimeError("that Proton server is not imported any more")
    for o in connections():
        if o["active"] and o["uuid"] != uuid:
            nmcli("connection", "down", "uuid", o["uuid"], check=False)
    bring_up(uuid, first_dns(uuid, "10.2.0.1"),
             "The Proton server did not answer in 8 s (free servers get busy; or the config was revoked). Try another one.")
    loc = proton_location(c, countries(clusters()))
    remember("proton", uuid, uuid, f"{loc['country']} {loc['city']}")
    return {"ok": True, "name": c["name"]}


def connect(provider, loc_id):
    if provider == "surfshark":
        return connect_surfshark(loc_id)
    if provider == "proton":
        return connect_proton(loc_id)
    raise RuntimeError(f"unknown provider {provider}")


def toggle():
    if any(c["active"] for c in connections()):
        down()
        return {"ok": True, "action": "down"}
    last = read_json(LAST)
    if not last:
        raise RuntimeError("no VPN used yet: pick a location in the panel")
    return dict(connect(last["provider"], last["id"]), action="up")


# --------------------------------------------------------------------------- import

def parse_conf(text):
    sec, data = None, {"Interface": {}, "Peer": {}}
    comments = []
    for raw in text.splitlines():
        line = raw.strip()
        if line.startswith("#"):
            comments.append(line)
            continue
        if line.startswith("[") and line.endswith("]"):
            sec = line[1:-1]
            continue
        if "=" in line and sec in data:
            k, _, v = line.partition("=")
            data[sec][k.strip()] = v.strip()
    return data, comments


def looks_like_wg(path):
    try:
        if path.stat().st_size > 20000:
            return False
        d, _ = parse_conf(path.read_text(errors="replace"))
    except OSError:
        return False
    return bool(d["Interface"].get("PrivateKey") and d["Peer"].get("PublicKey") and d["Peer"].get("Endpoint"))


def detect_provider(path, data, comments):
    name = path.name.lower()
    ep = data["Peer"].get("Endpoint", "").lower()
    dns = data["Interface"].get("DNS", "")
    if "surfshark" in name or "surfshark" in ep:
        return "surfshark"
    if name.startswith(("wg-", "proton")) or "10.2.0.1" in dns or any("netshield" in c.lower() or "proton" in c.lower() for c in comments):
        return "proton"
    return None


def location_of(path):
    """wg-US-FREE-12.conf, proton-JP-FREE-3.conf → US-FREE-12."""
    return re.sub(r"^(wg|proton|protonvpn)[-_]", "", path.stem, flags=re.I).upper().replace("_", "-")


def add_v6_blackhole(text, data):
    """Route IPv6 into the tunnel when the provider has none, so it cannot bypass it."""
    addrs = data["Interface"].get("Address", "")
    allowed = data["Peer"].get("AllowedIPs", "")
    if ":" in addrs or "0.0.0.0/0" not in allowed:
        return text, False
    out = []
    for line in text.splitlines():
        s = line.strip()
        if re.match(r"(?i)address\s*=", s):
            line = f"{line.rstrip()}, {V6_BLACKHOLE}"
        elif re.match(r"(?i)allowedips\s*=", s) and "::/0" not in s:
            line = f"{line.rstrip()}, ::/0"
        out.append(line)
    return "\n".join(out) + "\n", True


def iface_name(prefix, location, taken):
    base = (prefix + "-" + re.sub(r"[^a-z0-9]", "", location.lower()))[:13]
    name, n = base, 2
    while name in taken:
        name = f"{base[:12]}{n}"
        n += 1
    return name


def nm_import(text, iface, conn_name):
    """Import a WireGuard config as a NetworkManager profile with the leak protections; returns its uuid."""
    data, _ = parse_conf(text)
    text, _ = add_v6_blackhole(text, data)
    with tempfile.TemporaryDirectory() as td:
        tmp = Path(td) / f"{iface}.conf"   # nmcli names the interface after the file
        tmp.write_text(text)
        tmp.chmod(0o600)
        out = nmcli("connection", "import", "type", "wireguard", "file", str(tmp))
    m = re.search(r"\(([0-9a-f-]{36})\)", out)
    if not m:
        raise RuntimeError(f"nmcli import gave no uuid: {out.strip()}")
    uuid = m.group(1)
    nmcli("connection", "modify", "uuid", uuid,
          "connection.id", conn_name, "connection.autoconnect", "no",
          "ipv4.dns-priority", "-50", "ipv6.dns-priority", "-50", "ipv4.dns-search", "~.")
    return uuid


def keep_conf(path):
    CONFIGS.mkdir(parents=True, exist_ok=True)
    CONF_DIR.chmod(0o700)
    CONFIGS.chmod(0o700)
    dest = CONFIGS / path.name
    if path.resolve() != dest.resolve():
        shutil.move(str(path), dest)
    dest.chmod(0o600)


def import_one(path, provider=None):
    path = Path(path).expanduser()
    text = path.read_text()
    data, comments = parse_conf(text)
    if not (data["Interface"].get("PrivateKey") and data["Peer"].get("Endpoint")):
        raise RuntimeError(f"{path.name}: not a WireGuard config")
    provider = provider or detect_provider(path, data, comments)
    if provider == "surfshark":
        # One key pair serves every location: keep the key, the profile is written per location.
        iface = data["Interface"]
        write_json(SS_KEY, {"privateKey": iface["PrivateKey"], "address": iface.get("Address", SS_ADDRESS).split(",")[0].strip(),
                            "dns": iface.get("DNS", SS_DNS), "source": "imported", "verified": False,
                            "created": int(time.time())}, mode=0o600)
        CONF_DIR.chmod(0o700)
        keep_conf(path)
        return {"name": "Surfshark key", "provider": "surfshark"}
    if provider != "proton":
        raise RuntimeError(f"{path.name}: provider not recognised (use --provider surfshark|proton)")
    location = location_of(path)
    conn_name = f"Proton {location}"
    for c in connections():
        if c["name"] == conn_name:
            nmcli("connection", "delete", "uuid", c["uuid"])
    taken = set(os.listdir("/sys/class/net"))
    taken |= set(nmcli("-t", "-f", "connection.interface-name", "connection", "show", check=False).splitlines())
    uuid = nm_import(text, iface_name("pv", location, taken), conn_name)
    keep_conf(path)
    return {"name": conn_name, "uuid": uuid, "provider": "proton"}


def downloads_candidates():
    if not DOWNLOADS.is_dir():
        return []
    return sorted(p for p in DOWNLOADS.glob("*.conf") if looks_like_wg(p))


def import_many(paths, provider=None):
    paths = paths or downloads_candidates()
    done, errors = [], []
    for p in paths:
        try:
            done.append(import_one(p, provider))
        except Exception as e:  # noqa: BLE001 - one bad file must not stop the rest
            errors.append(f"{Path(p).name}: {e}")
    return {"ok": not errors and bool(done), "imported": done, "errors": errors,
            "error": "; ".join(errors) if errors else ("" if done else "no WireGuard .conf in ~/Downloads")}


def delete(ref):
    c = next((c for c in connections() if ref in (c["uuid"], c["name"])), None)
    if not c or not c["imported"]:
        raise RuntimeError("only servers imported here can be removed from the panel")
    nmcli("connection", "delete", "uuid", c["uuid"])
    return {"ok": True}


def forget_surfshark():
    for c in connections():
        if c["name"] == SS_PROFILE:
            nmcli("connection", "delete", "uuid", c["uuid"])
    SS_KEY.unlink(missing_ok=True)
    return {"ok": True}


def wg(*args, stdin=None):
    r = subprocess.run(["wg", *args], input=stdin, capture_output=True, text=True)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "wg failed (is wireguard-tools installed?)")
    return r.stdout.strip()


def key_info():
    key = read_json(SS_KEY)
    if not key:
        return None
    pub = key.get("publicKey")
    if not pub:
        try:
            pub = wg("pubkey", stdin=key["privateKey"] + "\n")
        except (RuntimeError, OSError):
            pub = ""
    return {"publicKey": pub, "source": key.get("source", "imported"), "verified": bool(key.get("verified")),
            "created": key.get("created")}


def surfshark_keygen(force=False):
    if SS_KEY.exists() and not force:
        raise RuntimeError("a Surfshark key is already set up (use --force to replace it)")
    priv = wg("genkey")
    pub = wg("pubkey", stdin=priv + "\n")
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    CONF_DIR.chmod(0o700)
    write_json(SS_KEY, {"privateKey": priv, "publicKey": pub, "address": SS_ADDRESS, "dns": SS_DNS,
                        "source": "generated", "verified": False, "created": int(time.time())}, mode=0o600)
    copied = False
    if shutil.which("wl-copy") and not os.environ.get("OMARCHY_VPN_NO_CLIPBOARD"):
        # wl-copy leaves a child serving the clipboard: never wait on its output pipes.
        r = subprocess.run(["wl-copy", pub], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        copied = r.returncode == 0
    return {"ok": True, "publicKey": pub, "copied": copied}


def leaktest():
    """bash.ws: resolve random names under a fresh id, then ask which resolvers asked for them."""
    ident = urllib.request.urlopen("https://bash.ws/id", timeout=5).read().decode().strip()
    if not re.fullmatch(r"[a-z0-9]{8,40}", ident):
        raise RuntimeError("the leak test service gave an unexpected answer")
    with ThreadPoolExecutor(10) as ex:
        wait([ex.submit(socket.getaddrinfo, f"{i}.{ident}.bash.ws", None) for i in range(1, 11)], timeout=5)
    rows = fetch_json(f"https://bash.ws/dnsleak/test/{ident}?json", timeout=8)
    seen = [{"ip": r.get("ip"), "country": r.get("country_name"), "org": r.get("org") or r.get("asn"), "type": r.get("type")}
            for r in rows if r.get("type") in ("ip", "dns")]
    connected = any(c["active"] for c in connections())
    home = read_json(HOME_NET, {})
    isp = {(home.get(k) or {}).get("organization", "").split(" ")[0].lower() for k in ("ipv4", "ipv6")} - {""}
    leaks = [r for r in seen if connected and isp and (r["org"] or "").split(" ")[0].lower() in isp]
    return {"ok": True, "connected": connected, "ips": [r for r in seen if r["type"] == "ip"],
            "dns": [r for r in seen if r["type"] == "dns"], "leaks": leaks,
            "isp": next(iter(isp), ""), "verdict": ("no VPN: everything shows your ISP" if not connected
                                                    else "leak: your ISP still sees traffic" if leaks else "no leaks"),
            "ts": int(time.time())}


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "status":
            res = status(refresh_ip="--refresh" in args)
        elif cmd == "locations":
            res = locations(refresh="--refresh" in args)
        elif cmd == "connect":
            res = connect(args[0], args[1])
        elif cmd == "down":
            down()
            res = {"ok": True}
        elif cmd == "toggle":
            res = toggle()
        elif cmd == "import":
            prov = None
            if "--provider" in args:
                i = args.index("--provider")
                prov = args[i + 1]
                args = args[:i] + args[i + 2:]
            res = import_many(args, prov)
        elif cmd == "delete":
            res = delete(args[0])
        elif cmd == "forget-surfshark":
            res = forget_surfshark()
        elif cmd == "surfshark-keygen":
            res = surfshark_keygen(force="--force" in args)
        elif cmd == "leaktest":
            res = leaktest()
        else:
            print(__doc__, file=sys.stderr)
            return 3
    except Exception as e:  # noqa: BLE001 - the panel shows the message
        res = {"ok": False, "error": str(e)}
    print(json.dumps(res))
    return 0 if res.get("ok", True) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/python3
"""Print the opencode usage record for the Omarchy agents bar panel.

User collector, not part of the omarchy package: the systemd user timer
`omarchy-agent-usage-extra.timer` writes its output to
~/.local/state/omarchy/agents/usage/opencode.json, where the packaged
`omarchy.agents` widget picks it up like any other agent.

Local stats: every assistant message in opencode's database
(~/.local/share/opencode/opencode.db), any provider. Models served by a
local runtime (Ollama, LM Studio, llama.cpp: a provider whose base URL points
at localhost) are tagged "· local".

Limits: local models have no quota, so the meters show the resources that do
cap them: the NVIDIA GPU's VRAM and, per model Ollama has loaded, how much of
it sits on the GPU. Read-only.
"""

import argparse
import json
import os
import sqlite3
import subprocess
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

AGENT_ID = "opencode"
AGENT_NAME = "opencode"
HOME = Path.home()
DB = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local" / "share") / "opencode" / "opencode.db"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "opencode" / "opencode.json"
OLLAMA = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")
if not OLLAMA.startswith("http"):
  OLLAMA = "http://" + OLLAMA
LOCAL_HINTS = ("localhost", "127.0.0.1", "0.0.0.0", "[::1]")

now = datetime.now()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=d)).strftime("%Y-%m-%d") for d in range(6, -1, -1)]


def number(value):
  try:
    return max(0, int(value or 0))
  except (TypeError, ValueError):
    return 0


def local_providers():
  """Provider ids whose models run on this machine."""
  ids = {"ollama", "lmstudio", "llama.cpp", "llamacpp"}
  try:
    config = json.loads(CONFIG.read_text())
  except (OSError, ValueError):
    return ids
  for pid, provider in (config.get("provider") or {}).items():
    url = str(((provider or {}).get("options") or {}).get("baseURL") or "")
    if any(hint in url for hint in LOCAL_HINTS):
      ids.add(pid)
  return ids


def local_stats():
  recent = {d: {"date": d, "messageCount": 0} for d in recent_dates}
  model_usage, today_by_model = {}, {}
  sessions, today_sessions, active = set(), set(), set()
  prompts = today_prompts = today_tokens = 0
  local = local_providers()

  rows = []
  if DB.is_file():
    try:
      conn = sqlite3.connect(DB.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
      conn.execute("PRAGMA query_only = ON")
      rows = conn.execute(
        "SELECT session_id, data FROM message"
        " WHERE data LIKE '%\"role\"%:%\"assistant\"%'"
        " AND CASE WHEN json_valid(data) THEN json_extract(data, '$.role') END = 'assistant'").fetchall()
      conn.close()
    except sqlite3.Error:
      rows = []

  for session_id, raw in rows:
    try:
      entry = json.loads(raw)
      tokens = entry.get("tokens") or {}
      cache = tokens.get("cache") or {}
      inp = number(tokens.get("input"))
      out = number(tokens.get("output")) + number(tokens.get("reasoning"))
      cread, cwrite = number(cache.get("read")), number(cache.get("write"))
      total = inp + out + cread + cwrite
      if not total:
        continue
      created = (entry.get("time") or {}).get("created")
      day = datetime.fromtimestamp(float(created) / 1000).strftime("%Y-%m-%d")
      provider = str(entry.get("providerID") or "")
      model = str(entry.get("modelID") or "unknown")
      model = f"{model} · local" if provider in local else f"{model} · {provider}" if provider else model
    except Exception:
      continue
    prompts += 1
    sessions.add(session_id)
    active.add(day)
    b = model_usage.setdefault(model, {"inputTokens": 0, "outputTokens": 0,
                                       "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
    b["inputTokens"] += inp
    b["outputTokens"] += out
    b["cacheReadInputTokens"] += cread
    b["cacheCreationInputTokens"] += cwrite
    if day in recent:
      recent[day]["messageCount"] += total
    if day == today:
      today_prompts += 1
      today_sessions.add(session_id)
      today_tokens += total
      today_by_model[model] = today_by_model.get(model, 0) + total

  return {
    "todayPrompts": today_prompts,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_tokens,
    "todayTokensByModel": today_by_model,
    "recentDays": [recent[d] for d in recent_dates],
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active),
    "activeDates": sorted(active),
    "modelUsage": model_usage,
  }


def gpu_limits():
  try:
    out = subprocess.run(["nvidia-smi", "--query-gpu=name,memory.used,memory.total",
                          "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, timeout=5).stdout
  except Exception:
    return []
  limits = []
  for line in out.strip().splitlines():
    try:
      name, used, total = [p.strip() for p in line.split(",")]
      used, total = float(used), float(total)
    except ValueError:
      continue
    if total > 0:
      label = f"VRAM {name.replace('NVIDIA GeForce ', '')} · {used / 1024:.1f}/{total / 1024:.0f} GB"
      limits.append({"label": label, "title": label, "percent": round(used / total, 4), "resetsAt": ""})
  return limits


def vram_total():
  try:
    out = subprocess.run(["nvidia-smi", "--query-gpu=memory.total", "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, timeout=5).stdout
    return sum(float(x) for x in out.split()) * 1024 * 1024
  except Exception:
    return 0


def ollama_state():
  """(limits, status line) for the models Ollama has loaded right now."""
  try:
    with urllib.request.urlopen(OLLAMA + "/api/ps", timeout=2) as r:
      models = json.loads(r.read()).get("models") or []
  except Exception:
    return [], "Ollama not running"
  limits = []
  for m in models:
    size, vram = number(m.get("size")), number(m.get("size_vram"))
    if not size:
      continue
    total = vram_total()
    if not total:
      continue
    cpu = 1 - vram / size
    title = f"{m.get('name', 'model')} · {vram / 2**30:.1f} GB VRAM" + (f" · {cpu:.0%} on CPU" if cpu > 0.01 else "")
    # Meter = share of the GPU's memory this model holds (offloading to the
    # CPU shows in the title); the countdown is when Ollama unloads it.
    limits.append({"label": title, "title": title, "percent": round(min(1.0, vram / total), 4),
                   "resetsAt": str(m.get("expires_at") or "")})
  names = ", ".join(m.get("name", "") for m in models)
  return limits, (f"Ollama · loaded: {names}" if names else "Ollama · idle")


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  parser.parse_args()

  ollama_limits, tier = ollama_state()
  record = {"schemaVersion": 1, "id": AGENT_ID, "name": AGENT_NAME,
            "updatedAt": datetime.now(timezone.utc).isoformat(),
            "ready": True, "hasLocalStats": True,
            "limits": gpu_limits() + ollama_limits,
            "tierLabel": tier, "usageStatusText": "",
            "authHelpText": "Local models have no quota; meters show GPU memory."}
  record.update(local_stats())
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()

#!/usr/bin/python3
"""Background rescuer for desktop freezes: detect them, try to thaw the
desktop without losing windows, and only as a last resort restart it.

  omarchy-freeze-guard daemon          watch in the background (systemd user service)
  omarchy-freeze-guard rescue [--hard] thaw now (SUPER+CTRL+SHIFT+ESCAPE; also from a TTY/ssh)
  omarchy-freeze-guard report          write a diagnostic report now
  omarchy-freeze-guard last            how the previous boot ended + latest reports

Detection, every `probeEvery` seconds:
  * Hyprland: asks its version on the control socket. Hyprland answers from
    its main loop, so no answer = frozen screen (the 2026-10-07 20:44 freeze:
    kernel and services alive, desktop dead);
  * the Omarchy shell (bar, menus, notifications, lock screen): `shell ping`
    every `shellEvery` s;
  * stopped processes (state T) among Hyprland, Xwayland and the shell.

Rescue ladder while Hyprland does not answer (seconds since the last answer):
  0 s    SIGCONT anything of the desktop that is stopped;
  10 s   report: thread states and kernel wait channels, nvidia-smi, PSI,
         journal, log tail -> ~/.local/state/omarchy-freeze/freeze-*.txt;
  20 s   if Xwayland does not answer either, restart it: Hyprland blocks on
         it synchronously. Only X11 apps close; Wayland windows stay;
  60 s   abort Hyprland (SIGABRT -> coredumpctl; SIGKILL 15 s later). SDDM
         comes back and omarchy-session reopens the windows.
  If Hyprland is in state D (inside the kernel, usually the GPU driver) no
  signal can reach it: only SysRq or a reset helps, and the report says so.

A shell that stops answering for `shellFailures` checks in a row is restarted
with `omarchy restart shell` (it re-locks the session if it was locked); at
most 3 times in 15 min. Memory thrashing is left to systemd-oomd (Omarchy
configures it: 50 % stall for 20 s kills the app).

Always on: an fsynced copy of the hyprland.log tail (the real one lives in
/run and dies with a reset), and once per boot a note on how the previous
boot ended (clean, reset, or never woke from suspend).

Config (optional): ~/.config/omarchy-freeze-guard/config.json
  {"probeEvery": 2, "probeTimeout": 2, "reportAfter": 10, "xwaylandAfter": 20,
   "recoverAfter": 60, "shellEvery": 10, "shellFailures": 3}
  recoverAfter / xwaylandAfter / shellFailures = 0 turns that step off.
"""

import datetime
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "omarchy-freeze"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config") / "omarchy-freeze-guard" / "config.json"
SESSION_DIR = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state") / "omarchy-session"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
DEFAULTS = {"probeEvery": 2, "probeTimeout": 2, "reportAfter": 10, "xwaylandAfter": 20,
            "recoverAfter": 60, "shellEvery": 10, "shellFailures": 3}
SHELL_RESTARTS = (3, 900)  # at most 3 shell restarts in 15 min
KEEP_REPORTS = 20
KEEP_LOGS = 5
LOG_TAIL_BYTES = 512 * 1024
MIRROR_EVERY = 15
NOISE = re.compile(r"UFW BLOCK|xkbcomp|keycode|Virtual modifier|Using 0, ignoring|LFSH|Using Lock|not fatal to the X")
CLEAN_END = re.compile(r"Unmounted /|Reached target .*(Shutdown|Power-Off|Reboot|Final Step)|"
                       r"System is (powering down|rebooting)|Journal stopped")


def log(*a):
  print("omarchy-freeze-guard:", *a, file=sys.stderr, flush=True)


def config():
  cfg = dict(DEFAULTS)
  try:
    cfg.update(json.loads(CONFIG.read_text()))
  except (OSError, ValueError):
    pass
  return cfg


def now():
  return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def write_durable(path, text):
  """Atomic write that survives a reset a few seconds later."""
  path.parent.mkdir(parents=True, exist_ok=True)
  tmp = path.with_name(path.name + ".tmp")
  with open(tmp, "w") as f:
    f.write(text)
    f.flush()
    os.fsync(f.fileno())
  tmp.replace(path)
  fd = os.open(path.parent, os.O_RDONLY)
  try:
    os.fsync(fd)
  finally:
    os.close(fd)


def run(cmd, timeout=5):
  try:
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    return (p.stdout + p.stderr).rstrip()
  except subprocess.TimeoutExpired:
    return f"(did not answer in {timeout} s: {' '.join(cmd)})"
  except OSError as e:
    return f"({e})"


def notify(summary, body, urgency="normal"):
  run(["notify-send", "-a", "Omarchy", "-u", urgency, summary, body])


def read(path, default=""):
  try:
    return Path(path).read_text(errors="replace")
  except OSError:
    return default


def tail(path, nbytes):
  try:
    with open(path, "rb") as f:
      f.seek(0, os.SEEK_END)
      f.seek(max(0, f.tell() - nbytes))
      return f.read().decode(errors="replace")
  except OSError:
    return ""


# ------------------------------------------------------------------ Hyprland

def instance():
  return os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def hypr_dir():
  return RUN / "hypr" / instance()


def hypr_pid():
  try:
    pid = int(read(hypr_dir() / "hyprland.lock").split()[0])
  except (IndexError, ValueError):
    return None
  return pid if Path(f"/proc/{pid}").exists() else None


def probe(timeout):
  """None if Hyprland answered, else why not."""
  s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
  s.settimeout(timeout)
  try:
    s.connect(str(hypr_dir() / ".socket.sock"))
    s.sendall(b"j/version")
    got = b""
    while True:
      chunk = s.recv(65536)
      if not chunk:
        break
      got += chunk
    return None if got else "empty answer"
  except socket.timeout:
    return f"no answer in {timeout} s"
  except OSError as e:
    return str(e)
  finally:
    s.close()


def threads(pid):
  rows = []
  for t in sorted(Path(f"/proc/{pid}/task").glob("*"), key=lambda p: int(p.name)):
    stat = read(t / "stat")
    m = re.match(r"\d+ \((.*)\) (\S)", stat)
    if m:
      rows.append(f"  {t.name:>8} {m.group(2)} {read(t / 'wchan') or '-':<32} {m.group(1)}")
  return "\n".join(rows)


# ------------------------------------------------------------------ rescue steps

def proc_state(pid):
  m = re.match(r"\d+ \(.*\) (\S)", read(f"/proc/{pid}/stat"))
  return m.group(1) if m else None


def pids_named(name):
  out = []
  for d in Path("/proc").glob("[0-9]*"):
    try:
      if read(d / "comm").strip() == name and d.stat().st_uid == os.getuid():
        out.append(int(d.name))
    except OSError:  # exited meanwhile
      pass
  return out


def desktop_pids():
  pids = {}
  hp = hypr_pid()
  if hp:
    pids[hp] = "Hyprland"
  for name in ("Xwayland", "quickshell"):
    for pid in pids_named(name):
      pids[pid] = name
  return pids


def thaw_stopped():
  """SIGCONT stopped desktop processes. Returns what it woke."""
  woke = []
  for pid, name in desktop_pids().items():
    if proc_state(pid) in ("T", "t"):
      try:
        os.kill(pid, signal.SIGCONT)
        woke.append(f"{name} ({pid})")
      except OSError:
        pass
  return woke


def xwayland():
  """(pid, display) of this session's Xwayland, or (None, None)."""
  for pid in pids_named("Xwayland"):
    args = read(f"/proc/{pid}/cmdline").split("\0")
    disp = next((a for a in args if re.fullmatch(r":\d+", a)), None)
    if disp:
      return pid, disp
  return None, None


def xwayland_ping(disp, timeout=3):
  try:
    p = subprocess.run(["xprop", "-root", "_NET_SUPPORTING_WM_CHECK"], capture_output=True, timeout=timeout,
                       env=dict(os.environ, DISPLAY=disp))
    return p.returncode == 0
  except subprocess.TimeoutExpired:
    return False
  except OSError:
    return True  # no xprop: cannot tell, do not touch Xwayland


def restart_xwayland(pid):
  """Hyprland starts a new Xwayland on demand. Only X11 apps are lost."""
  try:
    os.kill(pid, signal.SIGKILL)
  except OSError:
    return False
  return True


def omarchy_bin(name):
  return shutil.which(name) or f"/usr/share/omarchy/bin/{name}"


def shell_ping():
  try:
    p = subprocess.run([omarchy_bin("omarchy-shell"), "shell", "ping"], capture_output=True, text=True, timeout=6,
                       env=dict(os.environ, OMARCHY_SHELL_IPC_TIMEOUT="3s"))
    return p.returncode == 0
  except (subprocess.TimeoutExpired, OSError):
    return False


def restart_shell():
  out = run([omarchy_bin("omarchy-restart-shell")], timeout=60)
  return shell_ping(), out


def submap_reset():
  run(["hyprctl", "dispatch", 'hl.dsp.submap("reset")'], timeout=3)


def restart_dock():
  """The dock's supervisor relaunches it in ~2 s; its DnD once froze the whole desktop."""
  if not pids_named("nwg-dock-hyprla"):
    return False
  run(["pkill", "-x", "nwg-dock-hyprla"], timeout=3)
  return True


# ------------------------------------------------------------------ reports

def report(reason, pid=None, failures=()):
  pid = pid or hypr_pid()
  parts = [f"omarchy-freeze-guard report: {reason}",
           f"time: {datetime.datetime.now().isoformat(timespec='seconds')}",
           f"boot: {read('/proc/sys/kernel/random/boot_id').strip()}",
           f"kernel: {os.uname().release}",
           f"hyprland: pid {pid}, instance {instance()}"]
  if failures:
    parts.append("probe failures (last 10):\n" + "\n".join(f"  {f}" for f in list(failures)[-10:]))
  if pid:
    status = read(f"/proc/{pid}/status")
    state = re.search(r"^State:\s*(.*)$", status, re.M)
    parts.append(f"hyprland state: {state.group(1) if state else '?'}"
                 "  (D = stuck inside the kernel, usually the GPU driver; R/S = stuck in userspace)")
    parts.append("hyprland threads (tid, state, kernel wait channel, name):\n" + threads(pid))
  parts.append("load: " + read("/proc/loadavg").strip())
  for res in ("cpu", "memory", "io"):
    parts.append(f"pressure {res}:\n" + read(f"/proc/pressure/{res}").rstrip())
  mem = re.search(r"^MemAvailable:\s*(.*)$", read("/proc/meminfo"), re.M)
  parts.append("MemAvailable: " + (mem.group(1) if mem else "?"))
  parts.append("nvidia-smi:\n" + run(["nvidia-smi", "--query-gpu=name,driver_version,pstate,temperature.gpu,"
                                      "utilization.gpu,memory.used,memory.total,power.draw,clocks_event_reasons.active",
                                      "--format=csv"], timeout=8))
  ps = run(["ps", "-eo", "pid,stat,wchan:28,etime,pcpu,rss,comm", "--sort=-pcpu"])
  parts.append("processes (top CPU):\n" + "\n".join(ps.splitlines()[:26]))
  journal = run(["journalctl", "-b", "--since", "-3min", "-o", "short-precise", "-q", "--no-pager"], timeout=8)
  parts.append("journal, last 3 min (noise filtered):\n" +
               "\n".join(line for line in journal.splitlines() if not NOISE.search(line))[-20000:])
  parts.append("hyprland.log tail:\n" + tail(hypr_dir() / "hyprland.log", 24 * 1024))
  path = STATE / f"freeze-{now()}.txt"
  write_durable(path, "\n\n".join(parts) + "\n")
  prune(STATE.glob("freeze-*.txt"), KEEP_REPORTS)
  os.sync()
  return path


def prune(paths, keep):
  for p in sorted(paths)[:-keep]:
    try:
      p.unlink()
    except OSError:
      pass


def mirror_log(last):
  """Copy the tail of hyprland.log to disk when it changed. Returns its size."""
  src = hypr_dir() / "hyprland.log"
  try:
    size = src.stat().st_size
  except OSError:
    return last
  if size != last:
    write_durable(STATE / "hyprland-current.log", f"# instance {instance()}\n" + tail(src, LOG_TAIL_BYTES))
  return size


def rotate_log():
  """A log left by another Hyprland instance is the one from before a crash/reset: keep it."""
  cur = STATE / "hyprland-current.log"
  first = read(cur).split("\n", 1)[0]
  if first and first != f"# instance {instance()}":
    cur.replace(STATE / f"hyprland-{datetime.datetime.fromtimestamp(cur.stat().st_mtime):%Y%m%d-%H%M%S}.log")
    prune(STATE.glob("hyprland-2*.log"), KEEP_LOGS)


def save_session_copy():
  src = SESSION_DIR / "session.json"
  if src.exists():
    write_durable(SESSION_DIR / "session.freeze.json", read(src))


def recover(pid):
  save_session_copy()
  os.sync()
  log(f"Hyprland (pid {pid}) frozen: SIGABRT")
  try:
    os.kill(pid, signal.SIGABRT)
  except ProcessLookupError:
    return "gone before the signal"
  for _ in range(15):
    time.sleep(1)
    if not Path(f"/proc/{pid}").exists():
      return "aborted (core dump: coredumpctl info Hyprland)"
  try:
    os.kill(pid, signal.SIGKILL)
  except ProcessLookupError:
    return "aborted"
  time.sleep(5)
  return "killed" if not Path(f"/proc/{pid}").exists() else "still alive after SIGKILL: stuck in the kernel (state D), only SysRq or a reset helps"


# ------------------------------------------------------------------ previous boot

def previous_boot():
  """(verdict, last lines) for how the previous boot ended."""
  lines = run(["journalctl", "-b", "-1", "-n", "300", "-o", "short-precise", "-q", "--no-pager"], timeout=20).splitlines()
  if not lines or lines[0].startswith("("):
    return "unknown", lines
  useful = [line for line in lines if not NOISE.search(line)]
  last = "\n".join(lines[-40:])
  if any(CLEAN_END.search(line) for line in lines[-60:]):
    return "clean", useful[-40:]
  if "PM: suspend entry" in last and "PM: suspend exit" not in last:
    return "suspend", useful[-40:]
  return "reset", useful[-40:]


def check_previous_boot(force=False):
  boot = read("/proc/sys/kernel/random/boot_id").strip()
  marker = STATE / "checked-boot"
  if not force and read(marker).strip() == boot:
    return None
  verdict, lines = previous_boot()
  STATE.mkdir(parents=True, exist_ok=True)
  marker.write_text(boot)
  if verdict in ("clean", "unknown"):
    return verdict
  when = lines[-1][:22] if lines else "?"
  reports = sorted(STATE.glob("freeze-*.txt"))
  logs = sorted(STATE.glob("hyprland-2*.log"))
  text = {"suspend": f"The previous boot went to sleep ({when}) and never woke up: a reset was needed.",
          "reset": f"The previous boot ended without a shutdown ({when}): reset or power loss."}[verdict]
  body = [text, ""]
  if reports:
    body.append(f"Last freeze report: {reports[-1]}")
  if logs:
    body.append(f"Hyprland log from before the reset: {logs[-1]}")
  body.append("\nLast journal lines of that boot:\n" + "\n".join(lines))
  path = STATE / f"boot-{now()}-{verdict}.txt"
  write_durable(path, "\n".join(body) + "\n")
  prune(STATE.glob("boot-*.txt"), KEEP_REPORTS)
  notify("The last session ended badly", f"{text}\nDetails: {path}", "critical")
  return verdict


# ------------------------------------------------------------------ daemon

def note(path, text):
  """Append to a report, durably."""
  if not path:
    return
  with open(path, "a") as f:
    f.write(text + "\n")
    f.flush()
    os.fsync(f.fileno())


class Guard:
  """One step per tick; time comes from the caller so tests can drive it."""

  def __init__(self, cfg):
    self.cfg = {k: float(v) for k, v in cfg.items()}
    self.since = None        # monotonic time Hyprland stopped answering
    self.failures = []
    self.reported = None
    self.actions = []
    self.x_checked = False
    self.shell_ok_seen = False
    self.shell_fail = 0
    self.shell_next = 0.0
    self.shell_restarts = []

  def act(self, text):
    self.actions.append(text)
    log(text)
    note(self.reported, f"ACTION: {text}")

  def tick(self, t, pid):
    """Returns "recovered" when the ladder ended by restarting Hyprland."""
    woke = thaw_stopped()
    if woke:
      self.act("SIGCONT to stopped " + ", ".join(woke))
    why = probe(self.cfg["probeTimeout"])
    if why is None:
      if self.since is not None:
        frozen = t - self.since
        note(self.reported, f"\nTHAWED after {frozen:.0f} s" +
             (f" (steps: {'; '.join(self.actions)})" if self.actions else " by itself"))
        if self.reported or self.actions:
          notify("The desktop was frozen", f"Back after {frozen:.0f} s." +
                 (f"\nDone: {'; '.join(self.actions)}" if self.actions else "") +
                 (f"\nReport: {self.reported}" if self.reported else ""))
      self.since, self.failures, self.reported, self.actions, self.x_checked = None, [], None, [], False
      self.check_shell(t)
      return None
    self.since = self.since if self.since is not None else t - self.cfg["probeTimeout"]
    self.failures.append(f"{datetime.datetime.now():%H:%M:%S} {why}")
    frozen = t - self.since
    if not self.reported and frozen >= self.cfg["reportAfter"]:
      self.reported = report(f"Hyprland has not answered for {frozen:.0f} s", pid, self.failures)
      log("freeze report:", self.reported)
    xa = self.cfg["xwaylandAfter"]
    if xa > 0 and not self.x_checked and frozen >= xa:
      self.x_checked = True
      self.try_xwayland(pid)
    ra = self.cfg["recoverAfter"]
    if ra > 0 and frozen >= ra:
      result = recover(pid)
      self.act(f"Hyprland restarted after {frozen:.0f} s: {result}")
      return "recovered"
    return None

  def try_xwayland(self, pid):
    if proc_state(pid) == "D":
      note(self.reported, "Hyprland is in state D (inside the kernel): Xwayland is not the cause")
      return
    xpid, disp = xwayland()
    if not xpid:
      return
    if xwayland_ping(disp):
      note(self.reported, f"Xwayland ({disp}) answers: not the cause")
      return
    if restart_xwayland(xpid):
      self.act(f"Xwayland {disp} did not answer either: restarted it (X11 apps closed)")

  def check_shell(self, t):
    sf = self.cfg["shellFailures"]
    if sf <= 0 or t < self.shell_next:
      return
    self.shell_next = t + self.cfg["shellEvery"]
    if shell_ping():
      self.shell_ok_seen, self.shell_fail = True, 0
      return
    if not self.shell_ok_seen:  # still starting, or not part of this session
      return
    self.shell_fail += 1
    if self.shell_fail < sf:
      return
    self.shell_restarts = [r for r in self.shell_restarts if t - r < SHELL_RESTARTS[1]]
    if len(self.shell_restarts) >= SHELL_RESTARTS[0]:
      if self.shell_fail == sf:
        notify("The Omarchy shell keeps freezing", "Restarted 3 times in 15 min; leaving it alone.\n"
               "Try: omarchy restart shell", "critical")
      return
    path = report(f"the Omarchy shell has not answered {self.shell_fail} checks in a row")
    ok, out = restart_shell()
    self.shell_restarts.append(t)
    self.shell_fail, self.shell_ok_seen = 0, ok
    note(path, f"ACTION: omarchy restart shell -> {'answers again' if ok else 'still not answering'}\n{out}")
    log("shell restarted:", "ok" if ok else "failed")
    notify("The bar/shell was frozen", ("Restarted it." if ok else "Restart did not help.") + f"\nReport: {path}",
           "normal" if ok else "critical")


def daemon():
  cfg = config()
  STATE.mkdir(parents=True, exist_ok=True)
  if not instance():
    log("HYPRLAND_INSTANCE_SIGNATURE not set")
    return 1
  rotate_log()
  try:
    check_previous_boot()
  except Exception as e:  # never let the boot check stop the watchdog
    log("previous boot check failed:", e)
  guard = Guard(cfg)
  every = float(cfg["probeEvery"])
  log(f"watching {instance()} (report {cfg['reportAfter']:g} s, Xwayland {cfg['xwaylandAfter']:g} s, "
      f"restart {cfg['recoverAfter']:g} s, shell every {cfg['shellEvery']:g} s)")
  size, mirrored = -1, 0.0
  mono, boot = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
  while True:
    time.sleep(every)
    m, b = time.monotonic(), time.clock_gettime(time.CLOCK_BOOTTIME)
    slept = (b - boot) - (m - mono) > 5  # the machine was suspended in between
    mono, boot = m, b
    pid = hypr_pid()
    if pid is None:
      log("Hyprland is gone; stopping")
      return 0
    if slept:
      guard.since, guard.failures, guard.shell_fail = None, [], 0
      continue
    if guard.tick(m, pid) == "recovered":
      return 0
    if guard.since is None and m - mirrored >= MIRROR_EVERY:
      size, mirrored = mirror_log(size), m


def rescue(hard=False):
  """Manual thaw: everything that does not lose windows; --hard also restarts Hyprland."""
  done = []
  woke = thaw_stopped()
  if woke:
    done.append("SIGCONT to " + ", ".join(woke))
  pid = hypr_pid()
  alive = pid is not None and probe(2) is None
  if alive:
    submap_reset()
    done.append("keybinding submap reset")
  xpid, disp = xwayland()
  if xpid and not xwayland_ping(disp):
    if restart_xwayland(xpid):
      done.append(f"Xwayland {disp} restarted (X11 apps closed)")
  if alive or pid is None:
    if not shell_ping():
      ok, _ = restart_shell()
      done.append("shell restarted" + ("" if ok else " (still not answering)"))
    if restart_dock():
      done.append("dock restarted")
  elif pid:
    time.sleep(5)
    if probe(2) is None:
      done.append("Hyprland answers again")
    elif hard:
      done.append(f"Hyprland restarted: {recover(pid)}")
    else:
      done.append("Hyprland still frozen: the daemon restarts it at 60 s, or run: omarchy-freeze-guard rescue --hard")
  path = report("manual rescue")
  note(path, "\n".join(f"ACTION: {d}" for d in done) or "ACTION: nothing needed")
  summary = "; ".join(done) or "nothing was stuck"
  print(summary)
  print(path)
  if alive:
    notify("Desktop rescue", f"{summary}\nReport: {path}")
  return 0


def last():
  verdict, lines = previous_boot()
  print(f"previous boot: {verdict}")
  for line in lines[-15:]:
    print("  " + line)
  for pattern in ("boot-*.txt", "freeze-*.txt", "hyprland-2*.log"):
    found = sorted(STATE.glob(pattern))
    print(f"{pattern}: {len(found)}" + (f", latest {found[-1]}" if found else ""))
  return 0


def main(argv):
  cmd = argv[1] if len(argv) > 1 else "daemon"
  if cmd == "daemon":
    return daemon()
  if cmd == "rescue":
    return rescue(hard="--hard" in argv[2:])
  if cmd == "report":
    print(report("manual report"))
    return 0
  if cmd == "last":
    return last()
  print(__doc__)
  return 3


if __name__ == "__main__":
  sys.exit(main(sys.argv))
